        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Ana Pérez Soto\",\n  \"email\": \"ana.perez@correo.cl\",\n  \"telefono\": \"+56987654321\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Nombre actualizado\", () => pm.expect(pm.response.json().nombre).to.eql(\"Ana Pérez Soto\"));"
            ]
          }
        }
      ]
    },
