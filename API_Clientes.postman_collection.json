            "clientes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"x' OR '1'='1\",\n  \"email\": \"x' OR '1'='1\",\n  \"telefono\": \"1234567\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Email malicioso rechazado (400)\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
