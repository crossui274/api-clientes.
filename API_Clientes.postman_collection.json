{
  "info": {
    "name": "API Clientes - Semana 9",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Crear cliente (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/clientes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "clientes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Ana Pérez\",\n  \"email\": \"ana.perez@correo.cl\",\n  \"telefono\": \"+56912345678\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
              "const c = pm.response.json();",
              "pm.test(\"Devuelve id_cliente\", () => pm.expect(c.id_cliente).to.be.a(\"number\"));",
              "pm.collectionVariables.set(\"clienteId\", c.id_cliente);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Crear cliente con email duplicado (409)",
      "request": {
        "method": "POST",
        "header": [
          {
