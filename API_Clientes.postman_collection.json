    {
      "name": "9. Prueba inyección SQL en id (400)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/clientes/1 OR 1=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "clientes",
            "1 OR 1=1"
          ]
        },
        "description": "Intento de inyección SQL: la validación del id y las consultas parametrizadas lo bloquean."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Inyección SQL rechazada con 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Prueba inyección SQL en email (400/409 sin romper la BD)",
      "request": {
