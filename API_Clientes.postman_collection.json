        }
      ]
    },
    {
      "name": "4. Listar clientes (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/clientes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "clientes"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Respuesta es un arreglo\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Obtener cliente por id (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/clientes/{{clienteId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "clientes",
            "{{clienteId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"id coincide\", () => pm.expect(pm.response.json().id_cliente).to.eql(Number(pm.collectionVariables.get(\"clienteId\"))));"
            ]
          }
        }
      ]
    },
